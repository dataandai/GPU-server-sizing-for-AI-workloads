        {
          "stage_id": "rerank",
          "resource_profile": "gpu_rerank_batchable",
          "role_id": "reranker_role"
        },
        {
          "stage_id": "generate",
          "resource_profile": "gpu_llm_prefill_decode",
          "role_id": "llm_role"
        },
        {
          "stage_id": "optional_guardrail",
          "resource_profile": "gpu_or_cpu_guardrail",
          "role_id": "guardrail_role",
          "optional": true
        }
      ]
    },
