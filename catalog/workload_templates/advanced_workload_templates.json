{
  "schema_version": "1.0",
  "records": [
    {
      "template_id": "lib_retrieval_rerank_generation",
      "display_name": "Retrieval + Rerank + Generation",
      "template_family": "retrieval_rerank_generation",
      "runtime_preset_hint": "vllm",
      "batching_mode": "continuous_query_batching",
      "description": "Parameterized RAG-like pattern with retrieval, rerank, and generation stages.",
      "parameter_definitions": [
        {
          "name": "request_rate_per_sec",
          "label": "Request rate / sec",
          "type": "number",
          "default": 2.5,
          "min": 0.05
        },
        {
          "name": "avg_context_docs",
          "label": "Average context documents",
          "type": "integer",
          "default": 8,
          "min": 1
        },
        {
          "name": "avg_prompt_tokens",
          "label": "Average prompt tokens",
          "type": "integer",
          "default": 2400,
          "min": 128
        },
        {
          "name": "avg_output_tokens",
          "label": "Average output tokens",
          "type": "integer",
          "default": 420,
          "min": 32
        },
        {
          "name": "rerank_top_k",
          "label": "Rerank top-k",
          "type": "integer",
          "default": 24,
          "min": 1
